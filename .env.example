# TimeAtlas Environment Configuration
# Copy this file to .env.local for local development
# Never commit .env.local to version control

# Application
VITE_APP_NAME=TimeAtlas
VITE_APP_VERSION=2.0.0
VITE_API_URL=http://localhost:3000

# Analytics - Google Analytics 4
# Get ID from: https://analytics.google.com
VITE_GA_ID=
VITE_ENABLE_ANALYTICS=false

# Google AdSense
# Get ID from: https://www.google.com/adsense
VITE_GOOGLE_ADSENSE_ID=
VITE_ENABLE_ADSENSE=false

# Deployment
VITE_DEPLOYMENT_ENV=development
VITE_BUILD_TIME=
