# ==========================================
# LAYER 3: STATIC HTML RESOLUTION & SPA FALLBACK
# ==========================================
RewriteBase /

# 1. Unconditional Trailing-Slash Canonicalization (Fixes GSC Errors)
# If a URL has a trailing slash, strip it and 301 redirect immediately.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# 2. Serve prerendered .html directly for no-slash URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*?)$ $1.html [L]

# 3. Real 404 for unknown URLs.
# Every valid route is prerendered to a flat .html file, so anything that
# reaches this point is genuinely unknown. The old /index.html fallback
# returned the prerendered HOMEPAGE with HTTP 200 (homepage canonical +
# index,follow) for every bad URL — an infinite soft-404 generator that
# polluted crawl budget. Serve the prerendered 404 page with a true 404
# status instead.
ErrorDocument 404 /404.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]

