# ==========================================
# LAYER 0: CACHE-CONTROL HEADERS
# ==========================================
<IfModule mod_headers.c>
  # Hashed JS + CSS assets (Vite appends a content hash — safe to cache for 1 year)
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Self-hosted font files (filenames are static but content never changes)
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Static images (no content hash — use 30-day TTL, not immutable, so deploys can update them)
  <FilesMatch "\.(webp|png|jpg|jpeg|gif|ico|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Prerendered HTML + root index — always revalidate (no hash, content changes on deploy)
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ==========================================
# LAYER 1: HTTPS + HOST CANONICALIZATION
# ==========================================
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www → apex (canonical host is timeatlas.co)
RewriteCond %{HTTP_HOST} ^www\.timeatlas\.co$ [NC]
RewriteRule ^(.*)$ https://timeatlas.co/$1 [L,R=301]

# ==========================================
