#!/usr/bin/env bash

# Pre-commit hook to ensure code quality
# Generated by: code-first workflow setup

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Check TypeScript
echo -e "${YELLOW}Checking TypeScript...${NC}"
if ! npx tsc --noEmit; then
  echo -e "${RED}TypeScript check failed!${NC}"
  exit 1
fi
echo -e "${GREEN}✓ TypeScript check passed${NC}"

# Check formatting
echo -e "${YELLOW}Checking code formatting...${NC}"
if ! npx prettier --check . --ignore-path .gitignore 2>/dev/null; then
  echo -e "${YELLOW}Some files need formatting. Running prettier...${NC}"
  npx prettier --write . --ignore-path .gitignore 2>/dev/null
  echo -e "${GREEN}✓ Formatting fixed${NC}"
fi

# Check for lint issues (optional - remove if not using ESLint)
# echo -e "${YELLOW}Checking linting...${NC}"
# if ! npm run lint 2>/dev/null; then
#   echo -e "${YELLOW}Linting issues found (non-blocking)${NC}"
# fi

echo -e "${GREEN}✓ All pre-commit checks passed${NC}"
exit 0
